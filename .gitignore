# Dependencies
node_modules/
vendor/

# Build artifacts / Generated files
public/frontend/
public/build/
dist/
# Service worker и его runtime-файл генерируются при сборке фронтенда
# (vite-plugin-pwa). В репозитории им не место: прекэш указывает на файлы
# сборки с хешами в имени, которых в чистом клоне нет.
public/sw.js
public/workbox-*.js

# Симлинк на загруженные файлы (создаётся командой php artisan storage:link).
# В репозитории ему не место: путь жёстко зашит под машину разработчика
# и на другой системе превращается в обычный текстовый файл.
public/storage

# Environment files — в них пароли от базы, почты и внешних сервисов.
.env
.env.local
.env.*.local
.env.backup
.env.*.backup
.env.production
# ...но пример без секретов остаётся в репозитории.
!.env.example

# Ключ шифрования Laravel и любые ключи/сертификаты.
*.key
*.pem
*.p12
*.pfx

# Локальная памятка с паролем администратора — в репозиторий ей не место.
ADMIN.md
admin.md

# Локальные базы и дампы: в них хеши паролей пользователей.
*.sqlite
*.sqlite3
database/*.sqlite
database/*.sqlite3
*.sql
*.sql.gz

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / tool caches
.phpunit.result.cache
.phpunit.cache/

# Сгенерированные данные рецептов из интернета (собирает fetch_web_recipes.mjs)
database/seeders/data/web_recipes.json
.web_recipes_cache.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?